---
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

const ROOT = process.cwd();
const PENDING_PATH = join(ROOT, 'news-pending.json');
const PUBLISHED_PATH = join(ROOT, 'news.json');

let pendingItems = [];
let publishedCount = 0;

if (existsSync(PENDING_PATH)) {
  try {
    const data = JSON.parse(readFileSync(PENDING_PATH, 'utf8'));
    pendingItems = data.items || [];
  } catch (e) {
    console.warn('Pending dosyası okunamadı:', e.message);
  }
}

if (existsSync(PUBLISHED_PATH)) {
  try {
    const data = JSON.parse(readFileSync(PUBLISHED_PATH, 'utf8'));
    publishedCount = (data.items || []).length;
  } catch (e) {}
}

function formatDate(isoString) {
  const date = new Date(isoString);
  return date.toLocaleString('tr-TR', { dateStyle: 'short', timeStyle: 'short' });
}

const CATEGORY_LABELS = { urun: 'Ürün', sirket: 'Şirket', trend: 'Trend' };
---

<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin — Haber Onayı | Nayomy</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
      background: #FBFAF7;
      color: #0F0E0C;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2rem;
      border-bottom: 0.5px solid rgba(0,0,0,0.1);
      padding-bottom: 1rem;
    }
    h1 {
      font-size: 24px;
      font-weight: 600;
      margin: 0;
    }
    .stats {
      font-size: 13px;
      color: #888;
    }
    .stats strong { color: #0F0E0C; }

    .draft-card {
      background: #FFF;
      border: 0.5px solid rgba(0,0,0,0.12);
      border-radius: 10px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    /* meta row */
    .draft-meta {
      display: flex;
      gap: 8px;
      align-items: center;
      font-size: 11px;
      color: #888;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }
    .source-badge {
      background: #f5f5f4;
      padding: 2px 8px;
      border-radius: 4px;
      color: #444;
      font-weight: 500;
    }
    .original-title { color: #aaa; font-style: italic; }

    /* category badge (view mode) */
    .category-badge {
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .cat-urun   { background:#dbeafe; color:#1d4ed8; }
    .cat-sirket { background:#fce7f3; color:#9d174d; }
    .cat-trend  { background:#f3f4f6; color:#374151; }

    /* title */
    .draft-title {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 0.5rem;
      line-height: 1.3;
    }
    .draft-title-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 17px;
      font-weight: 600;
      padding: 8px;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
    }

    /* summary */
    .draft-summary {
      font-size: 14px;
      color: #444;
      line-height: 1.6;
      margin: 0 0 0.75rem;
    }
    .draft-summary-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 14px;
      padding: 8px;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
      min-height: 70px;
      resize: vertical;
    }

    /* body */
    .draft-body {
      font-size: 13px;
      color: #666;
      line-height: 1.55;
      margin: 0 0 0.75rem;
      white-space: pre-wrap;
      background: #FBFAF7;
      border-radius: 6px;
      padding: 10px 12px;
      max-height: 160px;
      overflow: hidden;
      position: relative;
    }
    .draft-body::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 40px;
      background: linear-gradient(transparent, #FBFAF7);
      pointer-events: none;
    }
    .draft-body-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 13px;
      padding: 8px;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
      min-height: 180px;
      resize: vertical;
      line-height: 1.6;
    }
    .no-body {
      font-size: 12px;
      color: #aaa;
      font-style: italic;
      margin-bottom: 0.75rem;
    }

    /* category select */
    .category-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 0.5rem;
    }
    .category-label-sm {
      font-size: 11px;
      color: #888;
      min-width: 60px;
    }
    .draft-category-select {
      font-size: 12px;
      padding: 4px 8px;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      font-family: inherit;
      background: #FFF;
    }

    /* relatedLink */
    .draft-related {
      font-size: 12px;
      color: #F47836;
      margin-bottom: 0.75rem;
    }
    .draft-related a { color: #F47836; }
    .draft-related-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 0.5rem;
    }
    .draft-related-input {
      flex: 1;
      font-size: 13px;
      padding: 6px 8px;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      font-family: inherit;
    }
    .related-label-sm {
      font-size: 11px;
      color: #888;
      min-width: 60px;
    }

    /* actions */
    .source-link {
      font-size: 12px;
      color: #F47836;
      text-decoration: none;
      margin-right: auto;
    }
    .actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 0.75rem;
    }
    button {
      font-size: 13px;
      padding: 7px 13px;
      border: 0.5px solid rgba(0,0,0,0.15);
      border-radius: 6px;
      background: #FFF;
      color: #0F0E0C;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.15s;
      font-family: inherit;
    }
    button:hover { background: #f5f5f4; }
    .btn-publish { background: #16a34a; color: #FFF; border-color: #16a34a; }
    .btn-publish:hover { background: #15803d; }
    .btn-reject  { color: #dc2626; border-color: rgba(220,38,38,0.3); }
    .btn-reject:hover { background: #fef2f2; }
    .btn-edit    { color: #2563eb; border-color: rgba(37,99,235,0.3); }
    .btn-save    { color: #7c3aed; border-color: rgba(124,58,237,0.3); display:none; }

    .empty {
      text-align: center;
      padding: 4rem 1rem;
      color: #888;
      background: #FFF;
      border-radius: 10px;
    }
    .notice {
      background: #fffbeb;
      border: 0.5px solid #fbbf24;
      border-radius: 6px;
      padding: 12px 16px;
      font-size: 13px;
      color: #78350f;
      margin-bottom: 1.5rem;
    }
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      padding: 12px 20px;
      background: #0F0E0C;
      color: #FFF;
      border-radius: 8px;
      font-size: 13px;
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 1000;
    }
    .toast.show { opacity: 1; }

    /* view/edit toggling */
    .view-only { display: block; }
    .edit-only  { display: none; }
    .editing .view-only { display: none; }
    .editing .edit-only  { display: block; }
    .editing .edit-flex  { display: flex; }
    .editing .btn-save   { display: inline-block; }
    .edit-flex { display: none; }

    /* lang sections */
    .lang-section {
      border-top: 0.5px solid rgba(0,0,0,0.08);
      margin-top: 0.75rem;
      padding-top: 0.75rem;
    }
    .lang-label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #aaa;
      margin-bottom: 0.5rem;
      display: block;
    }
    .lang-label.en { color: #2563eb; }
    .lang-label.tr { color: #16a34a; }

    /* slug display (read-only) */
    .slug-row {
      display: flex;
      gap: 1.25rem;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }
    .slug-chip {
      font-size: 11px;
      color: #888;
      background: #f5f5f4;
      padding: 3px 8px;
      border-radius: 4px;
      font-family: monospace;
    }
    .slug-chip span { color: #aaa; margin-right: 4px; }

    /* EN body textarea */
    .draft-body-en-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 13px;
      padding: 8px;
      border: 1px solid rgba(37,99,235,0.2);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
      min-height: 180px;
      resize: vertical;
      line-height: 1.6;
    }
    .draft-body-en {
      font-size: 13px;
      color: #666;
      line-height: 1.55;
      margin: 0 0 0.75rem;
      white-space: pre-wrap;
      background: #eff6ff;
      border-radius: 6px;
      padding: 10px 12px;
      max-height: 120px;
      overflow: hidden;
      position: relative;
    }
    .draft-body-en::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 30px;
      background: linear-gradient(transparent, #eff6ff);
      pointer-events: none;
    }
    .draft-title-en-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 16px;
      font-weight: 600;
      padding: 8px;
      border: 1px solid rgba(37,99,235,0.2);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
    }
    .draft-summary-en-input {
      width: 100%;
      box-sizing: border-box;
      font-size: 14px;
      padding: 8px;
      border: 1px solid rgba(37,99,235,0.2);
      border-radius: 6px;
      margin-bottom: 0.5rem;
      font-family: inherit;
      min-height: 70px;
      resize: vertical;
    }
    .no-en { font-size: 12px; color: #bbb; font-style: italic; margin-bottom: 0.5rem; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Haber Onayı</h1>
      <div class="stats">
        <strong>{pendingItems.length}</strong> taslak · <strong>{publishedCount}</strong> yayında
      </div>
    </div>

    <div class="notice">
      ℹ️ <strong>Sistemin çalışması:</strong> Onayladığın haberler hemen <code>news.json</code>'a eklenir, Vercel deploy alır, 1-2 dakika içinde nayomy.com/haberler'de canlıya çıkar. Reddettiklerin silinir, bir daha gösterilmez.
    </div>

    {pendingItems.length === 0 ? (
      <div class="empty">
        <p>📭 Onay bekleyen taslak yok.</p>
        <p style="font-size: 13px; color: #aaa;">Cron her sabah 09:00'da yeni haberleri çekiyor.</p>
      </div>
    ) : (
      <div id="drafts">
        {pendingItems.map((item) => (
          <article class="draft-card" data-id={item.id}>
            <div class="draft-meta">
              <span class="source-badge">{item.source}</span>
              <span>{formatDate(item.pubDate)}</span>
              {item.category && (
                <span class={`category-badge cat-${item.category}`}>
                  {CATEGORY_LABELS[item.category] || item.category}
                </span>
              )}
              <span class="original-title" title={item.originalTitle}>
                EN: {item.originalTitle?.slice(0, 55)}…
              </span>
            </div>

            {/* ── TR Section ── */}
            <div class="lang-section">
              <span class="lang-label tr">TR — Türkçe</span>
              <h3 class="draft-title view-only">{item.title}</h3>
              <input type="text" class="draft-title-input edit-only" value={item.title} />
              <p class="draft-summary view-only">{item.summary}</p>
              <textarea class="draft-summary-input edit-only">{item.summary}</textarea>
              {item.body ? (
                <p class="draft-body view-only">{item.body}</p>
              ) : (
                <p class="no-body view-only">— gövde yok (eski taslak)</p>
              )}
              <textarea class="draft-body-input edit-only">{item.body || ''}</textarea>
            </div>

            {/* ── EN Section ── */}
            <div class="lang-section">
              <span class="lang-label en">EN — English</span>
              <h3 class="draft-title-en view-only" style="font-size:17px;font-weight:600;margin:0 0 0.5rem;line-height:1.3;">
                {item.title_en || <span style="color:#bbb;font-weight:400;font-style:italic;">no title_en yet</span>}
              </h3>
              <input type="text" class="draft-title-en-input edit-only" value={item.title_en || ''} placeholder="English headline" />
              <p class="draft-summary-en view-only" style="font-size:14px;color:#3b5eaf;line-height:1.6;margin:0 0 0.75rem;">
                {item.summary_en || <span style="color:#bbb;font-style:italic;">no summary_en yet</span>}
              </p>
              <textarea class="draft-summary-en-input edit-only">{item.summary_en || ''}</textarea>
              {item.body_en ? (
                <p class="draft-body-en view-only">{item.body_en}</p>
              ) : (
                <p class="no-en view-only">— no body_en yet (older draft)</p>
              )}
              <textarea class="draft-body-en-input edit-only">{item.body_en || ''}</textarea>
            </div>

            {/* ── Slugs (read-only) ── */}
            <div class="slug-row">
              <span class="slug-chip"><span>slug TR:</span>{item.slug || '—'}</span>
              <span class="slug-chip"><span>slug EN:</span>{item.slug_en || '—'}</span>
            </div>

            {/* ── Category + Related (edit mode) ── */}
            <div class="category-row edit-flex">
              <span class="category-label-sm">Kategori</span>
              <select class="draft-category-select">
                <option value="urun"   selected={item.category === 'urun'}>Ürün</option>
                <option value="sirket" selected={item.category === 'sirket'}>Şirket</option>
                <option value="trend"  selected={item.category === 'trend' || !item.category}>Trend</option>
              </select>
            </div>

            {item.relatedLink && (
              <p class="draft-related view-only">
                🔗 <a href={item.relatedLink} target="_blank" rel="noopener">{item.relatedLink}</a>
              </p>
            )}
            {!item.relatedLink && (
              <p class="draft-related view-only" style="color:#aaa; font-size:12px;">🔗 İç link yok</p>
            )}
            <div class="draft-related-row edit-flex">
              <span class="related-label-sm">İç link</span>
              <input type="text" class="draft-related-input" value={item.relatedLink || ''} placeholder="/mcp/slug/ veya boş" />
            </div>

            {/* ── Actions ── */}
            <div class="actions">
              <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">Kaynak →</a>
              <button class="btn-edit" data-action="edit">Düzenle</button>
              <button class="btn-save" data-action="save">Kaydet</button>
              <button class="btn-publish" data-action="publish">✓ Yayınla</button>
              <button class="btn-reject" data-action="reject">✗ Reddet</button>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const toast = document.getElementById('toast');
    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }

    function getCardValues(card) {
      const isEditing = card.classList.contains('editing');
      return {
        title:      isEditing ? card.querySelector('.draft-title-input').value
                              : card.querySelector('.draft-title').textContent.trim(),
        summary:    isEditing ? card.querySelector('.draft-summary-input').value
                              : card.querySelector('.draft-summary').textContent.trim(),
        body:       card.querySelector('.draft-body-input').value,
        title_en:   isEditing ? card.querySelector('.draft-title-en-input').value
                              : card.querySelector('.draft-title-en')?.textContent.trim(),
        summary_en: isEditing ? card.querySelector('.draft-summary-en-input').value
                              : card.querySelector('.draft-summary-en')?.textContent.trim(),
        body_en:    card.querySelector('.draft-body-en-input').value,
        category:    card.querySelector('.draft-category-select').value,
        relatedLink: card.querySelector('.draft-related-input').value.trim() || null,
      };
    }

    async function apiCall(payload) {
      const res = await fetch('/api/news-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'include',
      });
      return res;
    }

    document.querySelectorAll('.draft-card').forEach(card => {
      const id = card.dataset.id;

      card.querySelector('[data-action="edit"]').addEventListener('click', () => {
        card.classList.toggle('editing');
        const btn = card.querySelector('[data-action="edit"]');
        btn.textContent = card.classList.contains('editing') ? 'Kapat' : 'Düzenle';
      });

      card.querySelector('[data-action="save"]').addEventListener('click', async () => {
        const btn = card.querySelector('[data-action="save"]');
        btn.disabled = true;
        btn.textContent = 'Kaydediliyor…';
        const values = getCardValues(card);
        const res = await apiCall({ action: 'update', id, ...values });
        btn.disabled = false;
        btn.textContent = 'Kaydet';
        if (res.ok) {
          showToast('✓ Kaydedildi');
          // category badge güncelle
          const badge = card.querySelector('.category-badge');
          const labels = { urun: 'Ürün', sirket: 'Şirket', trend: 'Trend' };
          if (badge) {
            badge.className = `category-badge cat-${values.category}`;
            badge.textContent = labels[values.category] || values.category;
          }
        } else {
          showToast('❌ Kaydetme hatası: ' + res.status);
        }
      });

      card.querySelector('[data-action="publish"]').addEventListener('click', async () => {
        const values = getCardValues(card);
        const res = await apiCall({ action: 'publish', id, ...values });
        if (res.ok) {
          card.style.transition = 'opacity 0.3s';
          card.style.opacity = '0';
          setTimeout(() => card.remove(), 300);
          showToast('✓ Yayınlandı');
        } else {
          showToast('❌ Hata: ' + res.status);
        }
      });

      card.querySelector('[data-action="reject"]').addEventListener('click', async () => {
        if (!confirm('Bu haberi reddet?')) return;
        const res = await apiCall({ action: 'reject', id });
        if (res.ok) {
          card.style.transition = 'opacity 0.3s';
          card.style.opacity = '0';
          setTimeout(() => card.remove(), 300);
          showToast('✗ Reddedildi');
        } else {
          showToast('❌ Hata: ' + res.status);
        }
      });
    });
  </script>
</body>
</html>
